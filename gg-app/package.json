{
  "name": "gg-app",
  "private": true,
  "version": "0.59.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:native": "tauri dev --config src-tauri/tauri.local.conf.json",
    "build": "tsc && vite build",
    "build:local-patched": "node scripts/build-local-hotfix.mjs",
    "build:local-hotfix": "pnpm build:local-patched",
    "launch:local-patched": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/launch-local-patched.ps1",
    "smoke:local-installed": "pnpm launch:local-patched",
    "update:local-fixes": "node scripts/update-with-local-fixes.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint --cache --ignore-pattern \"src/ContextMeter.test.tsx\" \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --cache --ignore-pattern \"src/ContextMeter.test.tsx\" \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html,json}\"",
    "preview": "vite preview",
    "stage:node": "node scripts/stage-node.mjs",
    "bundle:sidecar": "node scripts/bundle-sidecar.mjs",
    "prebundle": "pnpm stage:node && pnpm bundle:sidecar",
    "installer:art": "node installer/build-art.mjs",
    "bump": "node scripts/bump-version.mjs",
    "evidence:workspace-shell": "node scripts/workspace-shell-evidence.mjs",
    "test": "pnpm test:parallel && pnpm test:updater-serial && pnpm test:installer-serial && pnpm test:launcher-serial && pnpm test:workspace-narrow && pnpm test:workspace-shell-evidence",
    "test:parallel": "vitest run --exclude scripts/update-with-local-fixes.test.ts --exclude scripts/install-local-patched.test.mjs --exclude scripts/launch-local-patched.test.mjs --exclude scripts/workspace-shell-evidence.test.mjs",
    "test:updater-serial": "vitest run scripts/update-with-local-fixes.test.ts --no-file-parallelism",
    "test:installer-serial": "vitest run scripts/install-local-patched.test.mjs --no-file-parallelism",
    "test:launcher-serial": "vitest run scripts/launch-local-patched.test.mjs --no-file-parallelism",
    "test:workspace-narrow": "node scripts/workspace-narrow-regression.mjs",
    "test:workspace-shell-evidence": "vitest run scripts/workspace-shell-evidence.test.mjs --no-file-parallelism",
    "smoke:roadmap-reliability-dev": "node scripts/roadmap-reliability-dev-smoke.mjs --identity com.ggcoder.local-fork",
    "smoke:cross-pane-project-isolation-dev": "node scripts/cross-pane-project-isolation-dev-smoke.mjs --identity com.ggcoder.local-fork",
    "smoke:packaged": "node scripts/smoke-packaged-windows.mjs",
    "smoke:installed-local-fork": "node scripts/smoke-built-local-fork.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@kenkaiiii/error-mom": "^0.3.3",
    "@kenkaiiii/gg-core": "workspace:*",
    "@mediapipe/tasks-vision": "^0.10.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "highlight.js": "^11.10.0",
    "lucide-react": "^1.18.0",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.0.4",
    "vitest": "^4.0.0"
  }
}
