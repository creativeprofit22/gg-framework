{
  "name": "@kenkaiiii/gg-core",
  "version": "5.58.0",
  "type": "module",
  "description": "Provider-agnostic, UI-free shared foundation: model registry, auth, paths, telegram, voice",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenkaiiii/gg-framework.git",
    "directory": "packages/gg-core"
  },
  "exports": {
