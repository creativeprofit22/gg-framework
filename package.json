{
  "name": "gg-framework",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" && pnpm --filter matey lint && pnpm --filter gg-app lint",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix && pnpm --filter matey lint:fix && pnpm --filter gg-app lint:fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"Matey/**/*.{ts,tsx,css,html,json,md,yml}\" && pnpm --filter gg-app format",
    "format:check": "node scripts/format-check-reconstruction.mjs",
    "test": "pnpm test:audit-generated && pnpm test:contract-command && pnpm test:flow-command && pnpm test:parity-command && pnpm test:research-command && pnpm test:setup-sweep-command && pnpm test:ship-command && pnpm test:sweep-command && pnpm test:trace-command && pnpm test:ux-audit-command && pnpm test:ux-plan-command && pnpm test:release-ci-gate && pnpm --filter @kenkaiiii/gg-ai test && pnpm --filter @kenkaiiii/gg-agent test && pnpm --filter @kenkaiiii/gg-core test && pnpm --filter @kenkaiiii/ggcoder test && pnpm --filter gg-app test",
    "test:audit-generated": "node --test scripts/audit-generated.test.mjs",
    "test:contract-command": "node --test packages/ggcoder/scripts/install-contract-command.test.mjs",
    "test:flow-command": "node --test packages/ggcoder/scripts/install-flow-command.test.mjs",
    "test:parity-command": "node --test packages/ggcoder/scripts/install-parity-command.test.mjs",
    "test:research-command": "node --test packages/ggcoder/scripts/install-research-command.test.mjs",
    "test:setup-sweep-command": "node --test packages/ggcoder/scripts/install-setup-sweep-command.test.mjs",
    "test:ship-command": "node --test packages/ggcoder/scripts/install-ship-command.test.mjs",
    "test:sweep-command": "node --test packages/ggcoder/scripts/install-sweep-command.test.mjs",
    "test:trace-command": "node --test packages/ggcoder/scripts/install-trace-command.test.mjs",
    "test:ux-audit-command": "node --test packages/ggcoder/scripts/install-ux-audit-command.test.mjs",
    "test:ux-plan-command": "node --test packages/ggcoder/scripts/install-ux-plan-command.test.mjs",
    "test:release-ci-gate": "node --test scripts/verify-release-ci.test.mjs",
    "commands:install:contract": "node packages/ggcoder/scripts/install-contract-command.mjs",
    "commands:install:flow": "node packages/ggcoder/scripts/install-flow-command.mjs",
    "commands:install:parity": "node packages/ggcoder/scripts/install-parity-command.mjs",
    "commands:install:research": "node packages/ggcoder/scripts/install-research-command.mjs",
    "commands:install:setup-sweep": "node packages/ggcoder/scripts/install-setup-sweep-command.mjs",
    "commands:install:ship": "node packages/ggcoder/scripts/install-ship-command.mjs",
    "commands:install:sweep": "node packages/ggcoder/scripts/install-sweep-command.mjs",
    "commands:install:trace": "node packages/ggcoder/scripts/install-trace-command.mjs",
    "commands:install:ux-audit": "node packages/ggcoder/scripts/install-ux-audit-command.mjs",
    "commands:install:ux-plan": "node packages/ggcoder/scripts/install-ux-plan-command.mjs",
    "prepare": "pnpm build",
    "app:update:local-fixes": "pnpm --filter gg-app update:local-fixes",
    "app:build:local-patched": "pnpm --filter gg-app build:local-patched",
    "audit:generated:web": "node scripts/audit-generated.mjs web",
    "audit:generated:tauri": "node scripts/audit-generated.mjs tauri",
    "audit:generated:sidecar-deps": "node scripts/audit-generated.mjs sidecar-deps",
    "audit:generated:tauri-schemas": "node scripts/audit-generated.mjs tauri-schemas",
    "audit:generated:cache": "node scripts/audit-generated.mjs cache",
    "audit:generated:packages": "node scripts/audit-generated.mjs packages"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "playwright": "^1.60.0",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@electron/get",
      "better-sqlite3",
      "electron",
      "esbuild",
      "onnxruntime-node"
    ],
    "overrides": {
      "global-agent": "^4.1.3",
      "ip-address": "^10.3.1",
      "protobufjs": "^7.6.1",
      "tar": "^7.5.19",
      "ws": "^8.21.0",
      "hono": "^4.13.1",
      "fast-uri": "^3.1.5",
      "picomatch": "^2.3.2"
    }
  },
  "dependencies": {
    "marked": "^15.0.12"
  }
}
