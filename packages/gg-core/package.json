      "require": "./dist/model-registry.cjs"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js",
      "require": "./dist/paths.cjs"
    },
    "./project-notes": {
      "types": "./dist/project-notes.d.ts",
      "import": "./dist/project-notes.js",
      "require": "./dist/project-notes.cjs"
    },
    "./project-task-contract": {
      "types": "./dist/project-task-contract.d.ts",
      "import": "./dist/project-task-contract.js",
      "require": "./dist/project-task-contract.cjs"
    },
    "./project-notes-diagnostics": {
      "types": "./dist/project-notes-diagnostics.d.ts",
      "import": "./dist/project-notes-diagnostics.js",
      "require": "./dist/project-notes-diagnostics.cjs"
    },
    "./manual-completion-approval-protocol": {
      "types": "./dist/manual-completion-approval-protocol.d.ts",
      "import": "./dist/manual-completion-approval-protocol.js",
      "require": "./dist/manual-completion-approval-protocol.cjs"
    },
    "./phase-binding-protocol": {
      "types": "./dist/phase-binding-protocol.d.ts",
