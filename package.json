{
  "name": "gg-framework",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" && pnpm --filter matey lint && pnpm --filter gg-app lint",
    "lint:command-discovery": "eslint packages/ggcoder/src/core/command-discovery.ts packages/ggcoder/src/tools/command-information.ts packages/gg-core/src/referenced-files.ts gg-app/src/ReferencedFiles.tsx gg-app/src/AgentPane.tsx gg-app/src/agent.ts gg-app/src/useAgentEvents.ts",
    "lint:fix": "eslint \"packages/*/src/**/*.{ts,tsx}\" --fix && pnpm --filter matey lint:fix && pnpm --filter gg-app lint:fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"Matey/**/*.{ts,tsx,css,html,json,md,yml}\" && pnpm --filter gg-app format",
    "format:check": "node scripts/format-check-reconstruction.mjs",
    "test": "node scripts/test-support/run-stages.mjs test:run-temp test:audit-generated test:audit-command-family test:contract-command test:flow-command test:parity-command test:research-command test:setup-bench-command test:bench-kit test:setup-sweep-command test:ship-command test:sweep-command test:sweep-plan test:sweep-ledger test:trace-command test:ux-audit-command test:ux-plan-command test:release-ci-gate \"--filter @kenkaiiii/gg-ai test\" \"--filter @kenkaiiii/gg-agent test\" \"--filter @kenkaiiii/gg-core test\" \"--filter @kenkaiiii/ggcoder test\" \"--filter gg-app test\"",
    "test:run-temp": "node --test \"scripts/test-support/*.test.mjs\"",
    "test:audit-generated": "node scripts/test-support/with-run-temp.mjs node --test scripts/audit-generated.test.mjs",
    "test:audit-command-family": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/audit-command-family.test.mjs",
    "test:contract-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-contract-command.test.mjs",
    "test:flow-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-flow-command.test.mjs",
    "test:parity-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-parity-command.test.mjs",
    "test:research-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-research-command.test.mjs",
    "test:setup-bench-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-setup-bench-command.test.mjs",
    "test:bench-kit": "node scripts/test-support/with-run-temp.mjs node --test \"packages/ggcoder/scripts/bench-kit/*.test.mjs\"",
    "test:setup-sweep-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-setup-sweep-command.test.mjs",
    "test:ship-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-ship-command.test.mjs",
    "test:sweep-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-sweep-command.test.mjs",
    "test:sweep-plan": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/sweep-plan.test.mjs",
    "test:sweep-ledger": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/sweep-ledger.test.mjs",
    "test:trace-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-trace-command.test.mjs",
    "test:ux-audit-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-ux-audit-command.test.mjs",
    "test:ux-plan-command": "node scripts/test-support/with-run-temp.mjs node --test packages/ggcoder/scripts/install-ux-plan-command.test.mjs",
    "test:release-ci-gate": "node scripts/test-support/with-run-temp.mjs node --test scripts/verify-release-ci.test.mjs",
    "test:search-bench": "node scripts/test-support/with-run-temp.mjs node --test \"bench/search/*.test.mjs\"",
    "bench:search": "node bench/search-bench.mjs",
    "commands:install:contract": "node packages/ggcoder/scripts/install-contract-command.mjs",
    "commands:install:flow": "node packages/ggcoder/scripts/install-flow-command.mjs",
    "commands:install:parity": "node packages/ggcoder/scripts/install-parity-command.mjs",
    "commands:install:research": "node packages/ggcoder/scripts/install-research-command.mjs",
    "commands:install:setup-bench": "node packages/ggcoder/scripts/install-setup-bench-command.mjs",
    "commands:install:setup-sweep": "node packages/ggcoder/scripts/install-setup-sweep-command.mjs",
    "commands:install:ship": "node packages/ggcoder/scripts/install-ship-command.mjs",
    "commands:install:sweep": "node packages/ggcoder/scripts/install-sweep-command.mjs",
    "commands:install:trace": "node packages/ggcoder/scripts/install-trace-command.mjs",
    "commands:install:ux-audit": "node packages/ggcoder/scripts/install-ux-audit-command.mjs",
    "commands:install:ux-plan": "node packages/ggcoder/scripts/install-ux-plan-command.mjs",
    "app:update:local-fixes": "pnpm --filter gg-app update:local-fixes",
    "app:build:local-patched": "pnpm --filter gg-app build:local-patched",
    "audit:generated:web": "node scripts/audit-generated.mjs web",
    "audit:generated:tauri": "node scripts/audit-generated.mjs tauri",
    "audit:generated:sidecar-deps": "node scripts/audit-generated.mjs sidecar-deps",
    "audit:generated:tauri-schemas": "node scripts/audit-generated.mjs tauri-schemas",
    "audit:generated:cache": "node scripts/audit-generated.mjs cache",
    "audit:generated:packages": "node scripts/audit-generated.mjs packages"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.70.0"
  }
}
